{
  "name": "flowscore",
  "version": "0.1.0",
  "private": true,
  "description": "Flowscore — quiz funnel & lead scoring platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --skip-generate && next build",
