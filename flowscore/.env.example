# Postgres connection string. On Neon/Supabase, use the pooled URL.
# Example:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL=""

# Any long random string (32+ chars). Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-16-chars"

APP_URL="http://localhost:3000"

# Optional — PDF result emails via Resend (https://resend.com).
# If unset, PDFs are download-only (no email). Set both to enable.
# RESEND_API_KEY="re_xxx"
# RESEND_FROM="Flowscore <reports@your-verified-domain.com>"
