{
  "expo": {
    "name": "Recap Recorder",
    "slug": "recap-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "recap",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mrmoneycoach.recap",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Recap records your microphone so it can transcribe the meeting you're in."
      }
    },
    "android": {
      "package": "com.mrmoneycoach.recap",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Recap records your microphone so it can transcribe the meeting you're in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
